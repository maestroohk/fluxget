{
  "manifest_version": 3,
  "name": "FluxGet",
  "version": "0.7.0",
  "description": "Detects video and audio in the browser and sends downloads, streams and links to the FluxGet app on this computer.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "fluxget@maestroohk.github.io",
      "strict_min_version": "128.0"
    }
  }
}
