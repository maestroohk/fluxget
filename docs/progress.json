  "risks": [
    {
      "id": "R1",
      "text": "yt-dlp extraction breaks when sites change; needs bundled updater and fast yt-dlp upgrades.",
      "severity": "high"
    },
    {
      "id": "R2",
      "text": "Installer is unsigned until a code-signing certificate is obtained (SmartScreen warnings).",
      "severity": "medium"
    },
    {
      "id": "R3",
      "text": "MonoTorrent stable releases are infrequent (3.0.2); pinned and integration-tested.",
      "severity": "medium"
    },
    {
      "id": "R4",
      "text": "Expiring/cookie-bound URLs cannot be resumed after restart because cookies are kept in memory only by design.",
      "severity": "low"
    },
    {
      "id": "R5",
      "text": "GitHub publication blocked until the GitHub CLI is authenticated on this machine.",
      "severity": "medium"
    },
    {
      "id": "R6",
      "text": "Some mirrors (e.g. OVH proof servers) cap connections per IP and temporarily block clients that exceed it. FluxGet now backs off, lowers its connection count and remembers the cap per host, but the default connection count still needs benchmarking.",
      "severity": "medium"
    },
    {
      "id": "R7",
      "text": "IPv6 routes that black-hole connections stalled .NET's sequential connect; fixed with a Happy Eyeballs connector, needs testing on IPv6-only networks.",
      "severity": "low"
    }
  ],
